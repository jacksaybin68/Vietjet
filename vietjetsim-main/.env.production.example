# ==============================================================================
# VIETJET SIMULATOR - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# BẢO MẬT TUYỆT ĐỐI: KHÔNG commit file .env.production thật chứa thông tin nhạy cảm vào Git!
# Sử dụng CI/CD Secrets hoặc Secret Manager (GCP Secret Manager / AWS Secrets Manager)
# ==============================================================================

# ─── Production Server ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4028
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_SITE_URL=https://vietjet.example.com

# ─── Production Database (Neon Serverless Postgres / Pooled Connection) ───────
# Bắt buộc sử dụng kết nối bảo mật sslmode=require
DATABASE_URL=postgresql://user:strong_password@ep-production-instance.pooler.neon.tech/vietjet_db?sslmode=require

# ─── Authentication & JWT Secrets (Tối thiểu 64 hex characters) ───────────────
# Sinh ngẫu nhiên bằng lệnh: openssl rand -hex 32
JWT_SECRET=replace_with_openssl_generated_64_character_hex_secret_key_prod
JWT_REFRESH_SECRET=replace_with_another_openssl_generated_64_hex_secret_key_prod
CAPTCHA_SECRET=replace_with_captcha_hmac_secret_key_prod

# ─── VietQR & Payment Webhook Security ─────────────────────────────────────────
# Khóa bí mật đối soát chữ ký HMAC-SHA256 chống Replay Attack
VIETQR_WEBHOOK_SECRET=replace_with_strong_vietqr_signature_secret_key_prod

# ─── SMTP Email Delivery (Gửi vé máy bay & hóa đơn điện tử) ────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace_with_production_sendgrid_or_ses_api_key
SMTP_FROM="Vietjet Air E-Ticket <no-reply@vietjet.example.com>"

# ─── Social Login OAuth Credentials (Production) ──────────────────────────────
GOOGLE_CLIENT_ID=replace_with_production_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_production_google_oauth_client_secret
FACEBOOK_CLIENT_ID=replace_with_production_facebook_app_id
FACEBOOK_CLIENT_SECRET=replace_with_production_facebook_app_secret
APPLE_CLIENT_ID=replace_with_production_apple_service_id
APPLE_CLIENT_SECRET=replace_with_production_apple_private_key

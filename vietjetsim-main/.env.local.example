# ─── Database ───────────────────────────────────────────────────────────────
# Neon (Serverless Postgres) connection string.
# Leave empty to use the in-memory mock database (development only).
DATABASE_URL=

# ─── Auth secrets ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-random-64-hex-chars
JWT_REFRESH_SECRET=replace-with-another-random-64-hex-chars

# ─── Auth nâng cao (CAPTCHA + OTP SMS + Social Login) ───────────────────────
# Khoá ký CAPTCHA (HMAC-SHA256). Bỏ trống thì dùng JWT_SECRET, và ở môi trường
# dev là một hằng số công khai — production BẮT BUỘC đặt biến này.
CAPTCHA_SECRET=
# Không có SMS gateway trong repo: /api/xac-thuc/otp/gui ghi log mã và trả kèm
# `devCode` ngoài production. Cắm nhà cung cấp thật vào `sendOtpSms`
# (src/lib/skyjoy-otp.ts); bật/tắt việc trả `devCode` bằng NODE_ENV.
#
# Social Login: provider nào đủ cặp client id/secret thì nút bấm mới hoạt động
# (GET /api/xac-thuc/social báo trạng thái). Chưa có credential → nút hiện
# "sắp khả dụng". Callback/liên kết tài khoản là chỗ cắm còn lại.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── Public / client-exposed ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OPENCLAW_API_URL=

# ─── Server-only integrations ───────────────────────────────────────────────
OPENCLAW_API_KEY=

# ─── Ollama (LLM local cho trợ lý OpenClaw) ─────────────────────────────────
# Trợ lý admin (/api/tro-ly-ai/tro-chuyen) dùng Ollama khi có MỘT trong các
# biến dưới đây; không đặt gì thì vẫn gọi gateway OpenClaw như trước.
# Kiểm tra: curl http://localhost:11434/api/tags
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
# Ép backend: 'ollama' hoặc 'openclaw' (bỏ trống = tự chọn theo biến Ollama).
# OPENCLAW_PROVIDER=
# OLLAMA_TIMEOUT_MS=60000
# 'false' để tắt chế độ suy nghĩ của model qwen3 (trả lời nhanh hơn).
# OLLAMA_THINK=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Auto-switch model theo độ khó (xem src/lib/claude-model-router.ts).
# Câu dễ → FAST (rẻ), câu vừa → BALANCED, câu khó/code khó → STRONG.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-4-5
ANTHROPIC_MODEL_STRONG=claude-opus-4-5

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
# Hostinger (mailbox @vietjet.shop — đang dùng):
#   SMTP_HOST=smtp.hostinger.com   SMTP_PORT=465
#   SMTP_USER=booking@vietjet.shop  SMTP_PASS=<mat-khau-hop-thu-hostinger>
# Gmail (chỉ cho tài khoản Google: @gmail.com hoặc Google Workspace.
# KHÔNG dùng được với mailbox Hostinger):
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#   SMTP_USER=you@gmail.com    SMTP_PASS=<app-password-16-ky-tu>
#   Bật 2-Step Verification trước rồi tạo tại:
#   https://myaccount.google.com/apppasswords
#   (mật khẩu đăng nhập thường bị Google chặn qua SMTP)
# Resend (From phải là domain đã verify):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465
#   SMTP_USER=resend           SMTP_PASS=re_...
# MAIL_FROM phải trùng SMTP_USER (Gmail tự ghi đè/từ chối nếu lệch).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vietjet Air <booking@vietjet.shop>"
MAIL_REPLY_TO=booking@vietjet.shop
# Domain công khai cho link BÊN TRONG email (nút CTA, link reset mật khẩu...).
# Luôn là domain thật, kể cả môi trường dev.
MAIL_SITE_URL=https://vietjet.shop
# Logo dùng trong email (file public/logo.png). Ghi đè khi dùng CDN.
# MAIL_LOGO_URL=https://vietjet.shop/logo.png

# ─── Node env (optional override) ───────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development | production | test).
# NODE_ENV=development

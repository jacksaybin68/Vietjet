# ─── Database ───────────────────────────────────────────────────────────────
# Neon (Serverless Postgres) connection string.
# Leave empty to use the in-memory mock database (development only).
DATABASE_URL=

# ─── Auth secrets ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-random-64-hex-chars
JWT_REFRESH_SECRET=replace-with-another-random-64-hex-chars

# ─── Public / client-exposed ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OPENCLAW_API_URL=

# ─── Server-only integrations ───────────────────────────────────────────────
OPENCLAW_API_KEY=

# ─── Node env (optional override) ───────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development | production | test).
# NODE_ENV=development

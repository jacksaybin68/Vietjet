# ─── Database ───────────────────────────────────────────────────────────────
# Neon (Serverless Postgres) connection string.
# Leave empty to use the in-memory mock database (development only).
DATABASE_URL=

# ─── Auth secrets ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-random-64-hex-chars
JWT_REFRESH_SECRET=replace-with-another-random-64-hex-chars

# ─── Public / client-exposed ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OPENCLAW_API_URL=

# ─── Server-only integrations ───────────────────────────────────────────────
OPENCLAW_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
# Gmail App Password (bat 2-Step Verification truoc): https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#   SMTP_USER=you@gmail.com    SMTP_PASS=16-ky-tu-app-password
# Resend (From that la ten mien da verify):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465
#   SMTP_USER=resend           SMTP_PASS=re_...
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vietjet Air <bookbooking@vietjet.shop>"
MAIL_REPLY_TO=bookbooking@vietjet.shop

# ─── Node env (optional override) ───────────────────────────────────────────
# NODE_ENV is set automatically by Next.js (development | production | test).
# NODE_ENV=development

# Node modules
# node_modules/ only. `package-lock.json` is deliberately NOT ignored: CI runs
# `npm ci` in four jobs, which fails without a lockfile. It was ignored here
# from the first commit, which did nothing because the file was already tracked
# — but it is a trap: once anyone deletes it, `git add .` can never bring it
# back, and CI fails with a lockfile error instead of anything obvious.
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# IDEs
.cursor/
.zed/
.vscode/

# Build outputs
.next/
out/
build/
*.tsbuildinfo

# Project specific
vietjetsim-main/node_modules/
vietjetsim-main/.next/
.aider*

# Nested cloned repo (managed riêng, không commit vào repo cha)
Vietjet/

# OS / IDE / local artifacts
.DS_Store
.idea/
.ai/
*.backup
# `logs/` alone only matches the directory; the dev server's log sits beside it
# and was a 2 MB untracked file one `git add .` away from being pushed.
*.log

# Headless browser binary on server
chrome-bin/
